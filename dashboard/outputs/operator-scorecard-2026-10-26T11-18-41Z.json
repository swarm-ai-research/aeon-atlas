    "agent-resolved": {
      "type": "Badge",
      "props": {
        "text": "ISS-009 resolved 2026-10-25",
        "variant": "secondary"
      }
    },
    "community-section": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
