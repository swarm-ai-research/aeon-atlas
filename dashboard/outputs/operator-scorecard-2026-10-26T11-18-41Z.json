{
  "root": "card-root",
  "state": {},
  "elements": {
    "card-root": {
      "type": "Card",
      "props": {
        "title": "Operator Scorecard — 2026-10-26",
        "description": "Performance and health metrics"
      },
      "children": [
        "status-alert",
        "sep-1",
        "main-stack",
        "sep-2",
        "footer-stack"
      ]
    },
    "status-alert": {
      "type": "Alert",
      "props": {
        "type": "warning",
        "title": "🔴 DEGRADED",
        "message": "Economic lane dark; Agent stack P0-clear all week; Fleet-intelligence first dispatches"
      }
    },
    "sep-1": {
      "type": "Separator",
      "props": {}
    },
    "main-stack": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": "lg"
      },
      "children": [
        "agent-section",
        "community-section",
        "economic-section"
      ]
    },
    "agent-section": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": "md"
      },
