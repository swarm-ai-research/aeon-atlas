      "props": {
        "text": "6 stalled PRs:",
        "variant": "caption"
      }
    },
    "text_prs_list": {
      "type": "Text",
      "props": {
        "text": "#13, #14, #15, #16, #17, #18",
        "variant": "body"
      }
    }
  }
