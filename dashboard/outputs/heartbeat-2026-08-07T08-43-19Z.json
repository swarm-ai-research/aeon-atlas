    "stat_next_clean": {
      "type": "Stat",
      "props": {
        "label": "Next clean run",
        "value": "2026-08-07 08:00Z (now)"
      }
    },
    "stat_recovery": {
      "type": "Stat",
      "props": {
        "label": "Recovery status",
        "value": "Self-recovered this cycle"
