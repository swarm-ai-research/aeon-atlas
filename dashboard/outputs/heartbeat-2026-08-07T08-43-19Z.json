{
  "root": "card_main",
  "state": {},
  "elements": {
    "card_main": {
      "type": "Card",
      "props": {
        "title": "Heartbeat"
      },
      "children": [
        "alert_status",
        "sep1",
        "stack_content"
      ]
    },
    "alert_status": {
      "type": "Alert",
      "props": {
        "title": "🔴 DEGRADED",
