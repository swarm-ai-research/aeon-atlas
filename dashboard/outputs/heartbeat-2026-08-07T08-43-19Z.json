      }
    },
    "sep1": {
      "type": "Separator",
      "props": {
        "orientation": "horizontal"
      }
    },
    "stack_content": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": "md"
      },
      "children": [
        "section_incident",
        "sep2",
        "section_timeline",
        "sep3",
        "section_checkpoint",
        "sep4",
        "section_unchanged"
      ]
    },
    "section_incident": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": "sm"
      },
      "children": [
        "heading_incident",
        "text_dispatch",
        "text_hung",
        "text_gap"
      ]
    },
    "heading_incident": {
      "type": "Heading",
      "props": {
        "text": "Incident Details",
        "level": "h3"
      }
    },
    "text_dispatch": {
      "type": "Text",
      "props": {
        "text": "2026-08-06 14:00 UTC run dispatched at 15:18Z but hung before completing",
        "variant": "body"
      }
    },
    "text_hung": {
      "type": "Text",
      "props": {
        "text": "20:00 UTC slot never fired",
        "variant": "body"
      }
    },
    "text_gap": {
      "type": "Text",
      "props": {
        "text": "Result: approximately 24 hours with no fleet health checks",
        "variant": "body"
      }
    },
    "sep2": {
      "type": "Separator",
      "props": {
        "orientation": "horizontal"
      }
    },
    "section_timeline": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": "sm"
      },
      "children": [
        "heading_timeline",
        "stat_last_clean",
        "stat_next_clean",
        "stat_recovery"
      ]
    },
    "heading_timeline": {
      "type": "Heading",
      "props": {
        "text": "Timeline",
        "level": "h3"
      }
