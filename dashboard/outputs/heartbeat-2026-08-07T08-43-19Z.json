    "sep3": {
      "type": "Separator",
      "props": {
        "orientation": "horizontal"
      }
    },
    "section_checkpoint": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": "sm"
      },
      "children": [
        "heading_checkpoint",
        "text_resolve",
        "text_escalate",
        "badge_tracking"
      ]
