    "heading_frozen": {
      "type": "Heading",
      "props": {
        "text": "Frozen Service Status",
        "level": "h3"
      }
    },
    "text_frozen_service": {
      "type": "Text",
      "props": {
        "text": "Frozen service: atlas/atlas-layers"
      }
    },
    "text_frozen_duration": {
      "type": "Text",
      "props": {
        "text": "Frozen since: 2026-09-27 (19 days ago)"
      }
    },
    "text_recovery_unverified": {
      "type": "Text",
      "props": {
        "text": "Cohort recovery: Unverified until 2026-10-18 (Sunday)"
      }
    },
