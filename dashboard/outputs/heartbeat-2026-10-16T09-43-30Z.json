    "separator_4": {
      "type": "Separator",
      "props": {
        "orientation": "horizontal"
      }
    },
    "stack_frozen": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": "md"
      },
      "children": [
        "heading_frozen",
        "text_frozen_service",
        "text_frozen_duration",
        "text_recovery_unverified"
      ]
