      "type": "Separator",
      "props": {
        "orientation": "horizontal"
      }
    },
    "alert_action": {
      "type": "Alert",
      "props": {
        "title": "⚠️ Operator Action Required",
        "message": "Durable backstop (redundant offset cron / external workflow_dispatch) remains operator-action-required. Manual intervention needed to restore scheduler stability.",
        "type": "warning"
      }
    }
  }
